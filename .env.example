# Copy to .env and fill in values. Do not commit .env.

PORT=3000
API_GLOBAL_PREFIX=api

AUTH_SERVICE_HOST=localhost
AUTH_SERVICE_PORT=8877
USER_SERVICE_HOST=localhost
USER_SERVICE_PORT=8878
ADMIN_SERVICE_HOST=localhost
ADMIN_SERVICE_PORT=8879
EMPLOYEE_SERVICE_HOST=localhost
EMPLOYEE_SERVICE_PORT=8880
NOTIFICATION_SERVICE_HOST=localhost
NOTIFICATION_SERVICE_PORT=8881
FILE_SERVICE_HOST=localhost
FILE_SERVICE_PORT=8882
LOAN_SERVICE_HOST=localhost
LOAN_SERVICE_PORT=8883
PROVIDER_SERVICE_HOST=localhost
PROVIDER_SERVICE_PORT=8884
CHAT_SERVICE_HOST=localhost
CHAT_SERVICE_PORT=8885

# Chat service – Pusher (https://dashboard.pusher.com)
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=ap1

AUTH_TCP_PORT=8877
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=1h

RESEND_API_KEY=
EMAIL_FROM=StillPlay <onboarding@resend.dev>

# MongoDB (Prisma). Local without auth:
# DATABASE_URL=mongodb://localhost:27017/stillplay
# With user/password (URL-encode special chars in the password, e.g. @ -> %40):
#   DATABASE_URL=mongodb://USER:PASSWORD@host:27017/stillplay?authSource=admin
# Atlas-style:
#   DATABASE_URL=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/stillplay?retryWrites=true&w=majority
# "SCRAM failure: bad auth" = wrong user/password, wrong authSource, or password not URL-encoded.
DATABASE_URL=mongodb://localhost:27017/stillplay

ONE_SIGNAL_APP_ID=
ONE_SIGNAL_REST_API_KEY=

# File service – Cloudinary (https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
