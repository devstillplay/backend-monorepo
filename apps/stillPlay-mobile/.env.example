# Tawk.to live chat (optional — defaults to Still Play property/widget ids)
# NEXT_PUBLIC_TAWK_PROPERTY_ID=69f8250f3902bf1c376092b2
# NEXT_PUBLIC_TAWK_WIDGET_ID=1jnol1i3s

# API gateway base URL (must include /api). When unset, dev defaults to http://localhost:3000/api.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api

# BudPay (https://developer.budpay.com/developer-tools/reactjs)
# Replace with your own keys; these are test keys for development.
NEXT_PUBLIC_BUDPAY_PUBLIC_KEY=pk_test_ygdkehlstlctycduvnltb1xnq5yye594ev3qqg

# Paystack (test mode)
# Dashboard -> Settings -> API Keys & Webhooks
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: customer details sent to BudPay (fallbacks used if not set)
# NEXT_PUBLIC_BUDPAY_CUSTOMER_EMAIL=customer@example.com
# NEXT_PUBLIC_BUDPAY_CUSTOMER_FIRST_NAME=Customer
# NEXT_PUBLIC_BUDPAY_CUSTOMER_LAST_NAME=User
# NEXT_PUBLIC_BUDPAY_CUSTOMER_PHONE=08012345678

# Server-side only (do not use in client). For access code / initialize flows.
# BUDPAY_SECRET_KEY=<paste-from-budpay-dashboard>

# Server-side only (set on api-gateway service env, not in mobile app):
# PAYSTACK_SECRET_KEY=<paste-from-paystack-dashboard>

# Dojah Easy Onboard — Web SDK (`websdk.js` / `<dojah-button>`) needs this in the browser:
# Use the real widget id from Easy Onboard (Mongo ObjectId string). Leave empty until set — never NEXT_PUBLIC_DOJAH_WIDGET_ID=null (that sends the literal string "null" and Dojah returns 400).
NEXT_PUBLIC_DOJAH_WIDGET_ID=
# Optional: same app in dashboard — for server-side Dojah API / Connect if you use it
NEXT_PUBLIC_DOJAH_APP_ID=
NEXT_PUBLIC_DOJAH_PUBLIC_KEY=
# Only if Dojah support asks — otherwise leave unset (Next dev uses production widget host by default)
# NEXT_PUBLIC_DOJAH_USE_DEV_WIDGET=true
# Sandbox/production secret — server or API routes only (do NOT prefix with NEXT_PUBLIC_)
# DOJAH_SECRET_KEY=
# Optional: extra [Dojah] console logs in the browser (in addition to NODE_ENV=development)
# NEXT_PUBLIC_DEBUG_DOJAH=true
#
# Optional: DeviceGuard / device fingerprint POST URL (e.g. Elta). When `isNewDevice` is false, UI hints that KYC may be reused.
# NEXT_PUBLIC_DEVICEGUARD_FINGERPRINT_URL=https://deviceguard.elta.solutions/api/device-fingerprint
# NEXT_PUBLIC_DEVICEGUARD_API_KEY=
