# Copy to apps/api-gateway/.env or set in workspace root .env (Nx serve often loads root).
# Paystack secret key: Dashboard → Settings → API Keys (server only). Paste the real value in .env, never commit it.
PAYSTACK_SECRET_KEY=
#
# Paystack Dashboard → Settings → API Keys & Webhooks → Webhook URL (POST):
#   https://<YOUR_API_HOST>/api/notifications/webhooks/paystack
# Local dev: use ngrok (or similar) — Paystack cannot reach localhost.
